{
    "params": [
        {
            "name": "Song Title (Used as folder)",
            "type": "String",
            "defaultValue": "place"
        },
        {
            "name": "Song Title Tween",
            "type": "DropDown('linear', 'back', 'bounce', 'circ', 'cube', 'elastic', 'expo', 'quad', 'quart', 'quint', 'sine', 'smoothStep', 'smootherStep')",
            "defaultValue": "linear"
        },
        {
            "name": "Composer Tween",
            "type": "DropDown('linear', 'back', 'bounce', 'circ', 'cube', 'elastic', 'expo', 'quad', 'quart', 'quint', 'sine', 'smoothStep', 'smootherStep')",
            "defaultValue": "linear"
        },
        {
            "name": "Tween Type (ex: Out, inOut)",
            "type": "DropDown('In', 'Out', 'InOut')",
            "defaultValue": "In"
        },
        {
            "name": "Time On Screen",
            "type": "Float(3, 9999, 1, 3)",
            "defaultValue": "3"
        }
    ]
}